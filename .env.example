# Contact form (src/app/contact-us/actions.ts). Copy to .env.local and fill in.
# API key from https://resend.com/api-keys (Sending access is enough).
RESEND_API_KEY=
# Inbox that receives enquiries; comma-separate several addresses.
CONTACT_TO_EMAIL=enquiry@rock1builders.com
# Sender on a domain verified in Resend. Leave empty to use onboarding@resend.dev (test only:
# Resend then delivers only to the email address of the Resend account owner).
CONTACT_FROM_EMAIL="Rock1 Builders website <website@rock1builders.com>"
